{
  "name": "@hermesecommerce/storefront",
  "version": "0.1.0",
  "description": "SDK TypeScript de la Storefront API v2 de Pow/Hermes para storefronts headless.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PowEcommerce/hermes-storefront.git",
    "directory": "packages/storefront"
  },
  "homepage": "https://github.com/PowEcommerce/hermes-storefront/tree/main/packages/storefront#readme",
  "bugs": {
    "url": "https://github.com/PowEcommerce/hermes-storefront/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./content": {
      "import": {
        "types": "./dist/content.d.ts",
        "default": "./dist/content.js"
      },
      "require": {
        "types": "./dist/content.d.cts",
        "default": "./dist/content.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/generated/schema.d.ts && node scripts/generate-cache.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "build": "tsup",
    "prepack": "npm run build",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "test": "vitest run",
    "test:smoke": "STOREFRONT_SMOKE=1 vitest run test/smoke.test.ts"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "js-yaml": "^4.3.2",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
