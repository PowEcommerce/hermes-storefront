# Las variables HERMES_* las escribe `hermes link` (CLI @hermesecommerce/cli).
# Marca (X-Client-ID) y API. El SDK acepta la base con o sin /api.
HERMES_TENANT=
HERMES_API_URL=https://api.pow.la/api
# Token público de la marca, pst_… (puede llegar al navegador, pero acá se usa server-side)
HERMES_PUBLIC_TOKEN=
# Token privado de la agencia, psk_…: SÓLO servidor
HERMES_PRIVATE_TOKEN=
# Secreto de la suscripción storefront/revalidate, whsec_… (purga de caché; `hermes link --revalidate-url`)
HERMES_REVALIDATE_SECRET=
# Secreto del webhook checkout/completed (whsec_…), lo devuelve webhooks.create / rotateSecret
HERMES_WEBHOOK_SECRET=
# Tu dominio (tiene que estar entre los dominios permitidos del pst_)
SITE_URL=https://tienda.agencia.com
