# Las HERMES_* las escribe `hermes link` en .env (no hace falta copiarlas a mano).
# Marca (X-Client-ID), p. ej. tu-marca, y la API (https://api.pow.la/api).
HERMES_TENANT=
HERMES_API_URL=https://api.pow.la/api
# Token PÚBLICO de la marca (pst_…)
HERMES_PUBLIC_TOKEN=
# Token PRIVADO (psk_…): SÓLO servidor. Lo usa /checkout/vuelta para leer el pago.
HERMES_PRIVATE_TOKEN=
# Secreto del webhook storefront/revalidate (`hermes link --revalidate-url …`)
HERMES_REVALIDATE_SECRET=

# Opcional: dominios del sitio actual de la marca (links de los bloques del
# backoffice a esos dominios se abren dentro de la tienda).
# HERMES_BRAND_HOSTS=www.mimarca.com.ar,mimarca.com.ar

# Opcional: URL pública del sitio (return_url/cancel_url del checkout).
# Sin esto se arma con el host del pedido.
# SITE_URL=https://tienda.agencia.com
