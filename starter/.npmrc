# Sólo dentro del repo de Hermes: instala el SDK local (file:../packages/storefront)
# como copia y no como symlink, para que Next resuelva `next/cache` desde acá.
# `npm create @hermesecommerce/store` borra este archivo y usa la versión de npm.
install-links=true

# npm 10 (Node 20/22) falla con vitest 4 al resolver peer dependencies
# («Cannot read properties of null (reading 'edgesOut')»). Con esto instala
# bien; npm 11 no lo necesita. Las peers que hacen falta están declaradas
# explícitamente en package.json. La tienda nueva lleva sólo esta parte.
legacy-peer-deps=true
